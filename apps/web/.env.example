# Copy to `.env.local` to override. `.env.local` is git-ignored.
# The default below already works for local development against `npm run api:dev`.

# Where the browser sends API requests. Must be a URL the browser can reach, and its
# host must match the frontend's own host (both 127.0.0.1) for the session cookie to
# work — see docs/ARCHITECTURE.md#authentication.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
