# Copy to `.env` and adjust. `.env` is git-ignored.
# This single file is read by docker compose and by the API.

# --- PostgreSQL (docker compose) --------------------------------------------
POSTGRES_USER=nerva
POSTGRES_PASSWORD=nerva
POSTGRES_DB=nerva
# Host port. 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

# --- API ---------------------------------------------------------------------
# local | test | production
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://nerva:nerva@127.0.0.1:5433/nerva
# Used only by `npm run api:test`. Created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://nerva:nerva@127.0.0.1:5433/nerva_test
# Comma-separated list of browser origins allowed to call the API, with credentials.
# Use 127.0.0.1, not localhost, to match the web app's own origin (see
# docs/ARCHITECTURE.md#authentication) and apps/web/.env.example.
CORS_ORIGINS=http://127.0.0.1:3000
# Where the API redirects the browser after the Google OAuth callback finishes.
FRONTEND_BASE_URL=http://127.0.0.1:3000

# --- Nerva Connect: Google OAuth / Gmail (read-only) --------------------------
# Leave all three blank to run Nerva without Gmail. See README.md's "Connect Gmail"
# section for how to create these in Google Cloud. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/v1/integrations/google/callback
# A Fernet key that encrypts stored Google refresh tokens. Required to connect Gmail;
# generate your own per checkout, never share or commit it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# --- Nerva AI: conversation analysis -------------------------------------------
# Leave blank to run Nerva with AI analysis disabled. Never commit a real value.
OPENAI_API_KEY=
# Any OpenAI chat model that supports Structured Outputs.
NERVA_AI_MODEL=gpt-4o-mini
